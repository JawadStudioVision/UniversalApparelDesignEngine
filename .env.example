# OpenRouter API (Access to GPT-5.4-image-2, Flux Pro, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_IMAGE_MODEL=openai/gpt-5.4-image-2

# Shopify Store Configuration (Optional - for commercial sales mining & auto-pruning)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# Printify Integration (Optional - for automated fulfillment & sales tracking)
PRINTIFY_API_TOKEN=your_printify_jwt_token_here
PRINTIFY_SHOP_ID=your_printify_shop_id
